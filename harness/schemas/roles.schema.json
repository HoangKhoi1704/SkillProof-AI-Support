{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RolesResponse",
  "description": "Schema for supported prototype roles returned by GET /api/roles",
  "type": "array",
  "minItems": 2,
  "maxItems": 2,
  "items": {
    "type": "object",
    "required": ["id", "name", "description"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "enum": ["backend-developer", "financial-analyst"]
      },
      "name": {
        "type": "string",
        "enum": ["Backend Developer", "Financial Analyst"]
      },
      "description": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
