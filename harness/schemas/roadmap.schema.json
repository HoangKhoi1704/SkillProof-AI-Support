{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoadmapResponse",
  "description": "Schema for personalized learning roadmap from POST /api/roadmaps/generate",
  "type": "object",
  "required": ["roleId", "items"],
  "additionalProperties": false,
  "properties": {
    "roleId": {
      "type": "string",
      "enum": ["backend-developer", "financial-analyst"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["skill", "priority", "learningGoal", "practiceTask"],
        "additionalProperties": false,
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "learningGoal": {
            "type": "string",
            "minLength": 10
          },
          "practiceTask": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
