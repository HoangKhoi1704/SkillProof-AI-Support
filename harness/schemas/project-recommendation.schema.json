{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectRecommendationResponse",
  "description": "Schema for gap-backward real-world project recommendation from POST /api/projects/recommend",
  "type": "object",
  "required": ["title", "description", "reason", "requirements"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "reason": {
      "type": "string",
      "minLength": 15
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "targetsSkill"],
        "additionalProperties": false,
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 10
          },
          "targetsSkill": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
