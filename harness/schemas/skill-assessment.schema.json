{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillAssessmentResponse",
  "description": "Schema for diagnostic evaluation output from POST /api/diagnostics/evaluate",
  "type": "object",
  "required": ["roleId", "skills", "topGaps"],
  "additionalProperties": false,
  "properties": {
    "roleId": {
      "type": "string",
      "enum": ["backend-developer", "financial-analyst"]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "level", "reason", "evidence"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "Beginner",
              "Intermediate",
              "Advanced",
              "Insufficient Evidence"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "topGaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}
